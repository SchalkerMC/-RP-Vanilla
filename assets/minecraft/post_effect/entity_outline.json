                { "sampler_name": "In", "target": "minecraft:entity_outline" }
            ],
            "output": "swap"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "minecraft:post/no_glow_edge",
            "inputs": [
